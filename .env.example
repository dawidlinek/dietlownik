# dietlownik environment
#
# Only DATABASE_URL is required. Everything below is optional and shown with
# its in-code default — uncomment only what you actually want to change.
# Loaded via dotenv. See CLAUDE.md for how these fit together.

# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Scraper scope ────────────────────────────────────────────────────────────
# CITY=Wrocław                  # anchor city: always tracked, preferred home city
# CITY_REFRESH_HOURS=20         # refresh a tracked city once its data is older than this
# COMPANY=                      # single company slug (e.g. robinfood); skips company-list
# LIMIT=                        # cap number of companies processed
# COMPANY_CONCURRENCY=4         # companies scraped in parallel
# PER_COMPANY_CONCURRENCY=4     # parallel work within one company
# MENU_DAYS=                    # days of menu to fetch ahead
# ORDER_DAY_TIERS=              # comma-separated order lengths to price (e.g. 5,10,20)
# SCRAPE_SCHEDULER=0            # 1 = cron mode, daily 06:00 Warsaw (same as --repeat)

# Stage skips — set to 1 to skip
# SKIP_CITY_REFRESH=0          # per-city facts of tracked cities (catering list, fees, advertised prices)
# SKIP_PRICE_GROUPS=0          # quotes for cities that advertise different prices than the home city
# SKIP_MENUS=0
# SKIP_PRICES=0
# SKIP_PROMOS=0
# SKIP_TAGS=0

# ── HTTP client (scraper/api.ts) ─────────────────────────────────────────────
# DIETLY_API_BASE=https://aplikacja.dietly.pl
# MAX_IN_FLIGHT=               # default 3 under patchright, 32 on plain fetch
# MIN_INTERVAL_MS=             # default 300 under patchright, 0 on plain fetch
# RETRY_MAX=3
# RETRY_BASE_MS=500            # exponential backoff base
# REQUEST_TIMEOUT_MS=25000
# DIETLY_USER_AGENT=           # override the UA sent upstream
# DIETLY_LOG_REQUESTS=0        # 1 = log every request

# ── Cloudflare bypass (scraper/cf-fetch.ts, cf-shared.ts) ────────────────────
# Read the "Cloudflare bypass" section of CLAUDE.md before touching these.
# DIETLY_USE_PATCHRIGHT=1      # 0 = plain fetch + captured cookie (brittle)
# CF_HEADLESS=1                # 0 = watch the browser work
# CF_PAGE_POOL=1               # concurrent patchright pages
# CF_TIMEOUT_MS=120000
# CF_COOKIE_TTL_MS=300000
# CF_USER_DATA_DIR=            # default ~/.cache/dietlownik-cf-profile
# CF_KEEP_OPEN=0               # 1 = leave the browser open after a run
# STICKY_FALLBACK_MS=30000     # how long to stay on the fallback path after a failure
# DIETLY_PLAIN_FAST_PATH=1     # 0 = always go through the browser
# DIETLY_SESSION_FILE=         # default ./.cf-session.json
# DIETLY_COOKIE=               # raw cookie string, overrides the session file

# ── Browser binary (set by the Dockerfile; override locally if needed) ───────
# PLAYWRIGHT_BROWSERS_PATH=
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=   # e.g. /usr/bin/chromium
#
# NEXT_RUNTIME is set by Next.js itself — never set it by hand.

# ── Dashboard / MCP ──────────────────────────────────────────────────────────
# CITY_ID=986283               # Wrocław

# ── Embedding bench (see EMBEDDINGS.md, bench/README.md) ─────────────────────
# BENCH_CITY=986283
# BENCH_DAY=2026-05-20
# BENCH_POOL_SIZE=100
# BENCH_BATCH_SIZE=30
# BENCH_LABELER=claude-sonnet-4-5
# BENCH_LABELER_MODEL=claude-sonnet-4-5
# BENCH_MODELS=e5-small
# BENCH_POSITIVE_THRESHOLD=7
# BENCH_SLICE_ONLY=0
# BENCH_RESET=0

# Ad-hoc embedding eval (scraper/scripts/eval-embeddings.ts)
# EVAL_MODELS=
# EVAL_DB_LIMIT=40
# EVAL_SKIP_DB=0

# ── Tests ────────────────────────────────────────────────────────────────────
# INTEGRATION=0                # 1 = run tests that hit the live dietly API
# SKIP_HEAVY_TESTS=0           # 1 = skip model-loading tests
